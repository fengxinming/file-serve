{
  "name": "file-serve",
  "version": "0.0.1",
  "description": "局域网文件上传下载服务，支持断点续传（tus 协议）",
  "type": "module",
  "bin": {
    "file-serve": "dist/file-serve.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:web": "vite",
    "dev:server": "vite build -c vite.config.server.ts -w",
    "build": "npm run build:server && npm run build:web",
    "build:web": "vue-tsc -b && vite build",
    "build:server": "vite build -c vite.config.server.ts",
    "preview": "vite preview",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.3",
    "@vant/touch-emulator": "^1.5.0",
    "archiver": "^8.0.0",
    "cac": "^6.7.14",
    "fastify": "^5.11.3",
    "open": "^11.0.0",
    "tus-js-client": "^4.3.1",
    "vant": "^4.10.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.13.3",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "postcss-px-to-viewport": "^1.1.1",
    "tinyglobby": "^0.2.17",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
