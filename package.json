{
  "name": "lansrv",
  "version": "1.0.1",
  "description": "A local network file upload and download service. Run `lansrv` in any directory to serve that directory as the root for file browsing, downloading, and uploading. Supports resumable uploads (tus protocol).",
  "keywords": [
    "tus",
    "share",
    "file-serve"
  ],
  "homepage": "https://github.com/fengxinming/file-serve#readme",
  "bugs": {
    "url": "https://github.com/fengxinming/file-serve/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengxinming/file-serve.git"
  },
  "license": "MIT",
  "author": "Jesse Feng <fxm0016@126.com>",
  "type": "module",
  "main": "dist/server/index.mjs",
  "bin": {
    "lansrv": "dist/lansrv.mjs"
  },
  "directories": {
    "test": "tests"
  },
  "files": [
    "dist",
    "README_zh-CN.md"
  ],
  "scripts": {
    "deps": "rm -rf node_modules && pnpm install",
    "dev": "vite dev",
    "build": "npm run build:server && npm run build:web",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "vue-tsc -b && vite build",
    "build:server": "vite build -c vite.config.server.ts",
    "preview": "node dist/lansrv.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.3",
    "@vant/touch-emulator": "^1.5.0",
    "archiver": "^8.0.0",
    "cac": "^6.7.14",
    "fastify": "^5.11.3",
    "open": "^11.0.0",
    "pug": "^3.0.4",
    "tus-js-client": "^4.3.1",
    "vant": "^4.10.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@fastify/vite": "^10.0.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.13.3",
    "@types/postcss-pxtorem": "^6.1.0",
    "@types/pug": "^2.0.10",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "postcss-pxtorem": "^6.1.0",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.0",
    "vite-plugin-external": "^8.0.2",
    "vite-plugin-view": "^8.1.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
